# Copy this file to .env and fill in your own values. Never commit .env.

TESTFLOW_API_URL=https://your-testflow-deployment.vercel.app
TESTFLOW_EMAIL=you@hoichoi.tv
TESTFLOW_PASSWORD=your-testflow-password

# Absolute path to a local git checkout containing the flows/ folder
# (a full clone of the TestFlow repo is simplest — the agent runs `git pull`
# in this directory before every heartbeat so it always has the latest YAMLs).
TESTFLOW_REPO_DIR=C:\Users\you\TestFlow

# How often the agent reports devices/manifest and checks for a claimed run (ms).
HEARTBEAT_INTERVAL_MS=10000
